// Configuración Flick Ultra Extremo
const MULTIPLICADOR = 15; // Multiplica la velocidad del scroll por 15 pantallas
const VELOCITY_THRESHOLD = 0.15; // Sensibilidad ultra alta (responde al menor toque rápido)
let startX = 0, startY = 0, startTime = 0;

const editorContainer = document.querySelector('body');

editorContainer.addEventListener('touchstart', (e) => {
  const touch = e.touches[0];
  startX = touch.clientX;
  startY = touch.clientY;
  startTime = performance.now();
}, { passive: true });

editorContainer.addEventListener('touchend', (e) => {
  const touch = e.changedTouches[0];
  const deltaX = touch.clientX - startX;
  const deltaY = touch.clientY - startY;
  const deltaTime = Math.max(performance.now() - startTime, 1); // Evita división por cero

  const velocityX = Math.abs(deltaX) / deltaTime;
  const velocityY = Math.abs(deltaY) / deltaTime;

  if (velocityX > VELOCITY_THRESHOLD || velocityY > VELOCITY_THRESHOLD) {
    // Calculo del desplazamiento dinámico según la velocidad del gesto
    const moveX = deltaX * velocityX * MULTIPLICADOR * 10;
    const moveY = deltaY * velocityY * MULTIPLICADOR * 10;

    if (Math.abs(deltaX) > Math.abs(deltaY)) {
      // Movimiento horizontal extremo
      window.scrollBy({ left: moveX, behavior: 'auto' });
    } else {
      // Movimiento vertical extremo
      window.scrollBy({ top: moveY, behavior: 'auto' });
    }
  }
}, { passive: true });