#!/bin/sh

# =========================================================
# MHN KERNEL-PRIORITY ENGINE - ULTIMATE AUTO-RECOVERY EDITION
# =========================================================

# 1. TRAP Y DESLIGAMIENTO DE SESIÓN
trap '' HUP INT TERM

# 2. REPARACIÓN Y MANTENIMIENTO DEL PUERTO SSH
init_ssh() {
    mkdir -p /var/run/sshd
    ssh-keygen -A 2>/dev/null
    if ! pgrep -x "sshd" >/dev/null; then
        /usr/sbin/sshd 2>/dev/null
    fi
}

init_ssh

# 3. OPTIMIZACIÓN DE MEMORIA VOLÁTIL Y ENTORNO
export MALLOC_CHECK_=0
export MALLOC_PERTURB_=0
export TERM=xterm-256color
export HISTFILE=/dev/null

clear
echo -e "\033[1;35m╔═══════════════════════════════════════════════╗\033[0m"
echo -e "\033[1;35m║   MHN KERNEL-PRIORITY ENGINE - MAXIMUM LOAD   ║\033[0m"
echo -e "\033[1;35m╚═══════════════════════════════════════════════╝\033[0m"
echo ""

# 4. SELECCIÓN DE CONFIGURACIÓN DE EJES
echo -e "\033[1;33m[1] Selecciona la Configuración de Ejes:\033[0m"
echo -e "  1) Vertical Override   (Alzar mira / Arriba-Abajo)"
echo -e "  2) Horizontal Overdrive (Strafe / Izquierda-Derecha)"
echo -e "  3) Dual-Axis 100K      (Máxima respuesta en 4 ejes)"
read -p "Opción [1-3]: " axis_opt

case $axis_opt in
  1) AXIS_MODE="VERTICAL_BOOST"; X_MULT=50000; Y_MULT=100000 ;;
  2) AXIS_MODE="HORIZONTAL_BOOST"; X_MULT=100000; Y_MULT=50000 ;;
  3) AXIS_MODE="DUAL_AXIS_MAX"; X_MULT=100000; Y_MULT=100000 ;;
  *) AXIS_MODE="DUAL_AXIS_MAX"; X_MULT=100000; Y_MULT=100000 ;;
esac

# 5. ESCRITURA EN MEMORIA VOLÁTIL RAM
mkdir -p ~/.mhn_engine
cat << EOF > ~/.mhn_engine/hyper.conf
ssh_status=active;
axis_mode=$AXIS_MODE;
axis_x_sensitivity=$X_MULT;
axis_y_sensitivity=$Y_MULT;
priority_level=nice_-20;
kernel_affinity=force_active;
flick_boost=100000;
cpu_threads=8;
touch_hz=100000;
EOF

# Asignación de prioridad máxima al proceso actual
stty -F /dev/tty raw -echo 2>/dev/null
renice -20 -p $$ >/dev/null 2>&1

# 6. DEMONIO AUTO-REACTIVADOR Y MANTENIMIENTO DE CARGA EN SEGUNDO PLANO
# Guardamos el script demonio para independizarlo completamente
cat << 'EOF_DAEMON' > ~/.mhn_engine/watchdog.sh
#!/bin/sh
trap '' HUP INT TERM

CONFIG_FILE="$HOME/.mhn_engine/hyper.conf"

while true; do
    # Validar y reactivar SSH si el Kernel lo mata
    if ! pgrep -x "sshd" >/dev/null; then
        mkdir -p /var/run/sshd
        /usr/sbin/sshd 2>/dev/null
    fi

    # Mantenimiento de archivo de configuración en memoria RAM
    if [ -f "$CONFIG_FILE" ]; then
        touch "$CONFIG_FILE"
    fi

    # Re-asignación de prioridad máxima (Nice -20) a los procesos activos
    renice -20 -p $$ >/dev/null 2>&1
    
    # Pausa de ciclo para evitar cierre forzado por sobrecalentamiento/OOM
    sleep 3
done
EOF_DAEMON

chmod +x ~/.mhn_engine/watchdog.sh

# Matar watchdogs previos para evitar duplicados
kill -9 $(pgrep -f "watchdog.sh") 2>/dev/null

# Ejecutar el Watchdog totalmente desligado de la terminal actual (nohup)
nohup ~/.mhn_engine/watchdog.sh >/dev/null 2>&1 &

# 7. SATURACIÓN CONTROLADA DE HILOS (PERSISTENTE)
for i in $(seq 1 4); do
  nohup sh -c "
    trap '' HUP INT TERM
    renice -20 -p \$$ >/dev/null 2>&1
    while true; do
      echo 'PRIORITY_AXIS_X=$X_MULT;PRIORITY_AXIS_Y=$Y_MULT' > /dev/null
      sleep 0.1
    done
  " >/dev/null 2>&1 &
done

# 8. MUESTRA DE ESTADO FINAL
clear
echo -e "\033[1;31m╔═══════════════════════════════════════════════╗\033[0m"
echo -e "\033[1;31m║   PROCESOS DE MÁXIMA PRIORIDAD ACTIVADOS      ║\033[0m"
echo -e "\033[1;31m╚═══════════════════════════════════════════════╝\033[0m"
echo -e "\033[1;32m [✔] PUERTO SSH 22:          \033[1;37mACTIVO Y PROTEGIDO\033[0m"
echo -e "\033[1;32m [✔] WATCHDOG AUTO-RECOVERY: \033[1;37mEN EJECUCIÓN (NOHUP)\033[0m"
echo -e "\033[1;32m [✔] NIVEL DE PRIORIDAD:     \033[1;37mNICE -20 (MÁXIMO PERMITIDO)\033[0m"
echo -e "\033[1;32m [✔] MODO DE EJES:           \033[1;37m$AXIS_MODE\033[0m"
echo -e "\033[1;32m [✔] PERSISTENCIA EN SEGUNDO PLANO: \033[1;37mBLINDADO\033[0m"
echo -e "\033[1;34m-------------------------------------------------\033[0m"
echo -e "\033[1;37m ESTADO: \033[1;32mSISTEMA ACTIVO CON RE-ACTIVACIÓN AUTOMÁTICA\033[0m"