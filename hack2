<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>120 FPS + Aimlock MHN</title>
<style>
body{background:#000;color:#0f0;font-family:sans-serif;text-align:center;padding:50px;}
button{display:block;width:200px;margin:10px auto;padding:15px;font-size:18px;background:#111;color:#0f0;border:2px solid #0f0;border-radius:10px;}
</style>
</head>
<body>
<h1>⚡ 120FPS + Aimlock MHN</h1>
<button onclick="send('force_120fps_on')">120FPS ON</button>
<button onclick="send('force_120fps_off')">120FPS OFF</button>
<button onclick="send('aimlock_on')">Aimlock ON</button>
<button onclick="send('aimlock_off')">Aimlock OFF</button>
<button onclick="send('recoil_control')">Recoil Control</button>
<script>
const ws = new WebSocket('ws://TU_DOMINIO_O_IP:8080');
ws.onopen = ()=>console.log('Conectado al server');
ws.onmessage = m=>console.log('<-',m.data);
function send(cmd){ ws.send(cmd); alert('Enviado: '+cmd); }
</script>
</body>
</html>