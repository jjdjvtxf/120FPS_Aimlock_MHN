{
  "version": "2.2.0",
  "touch_config": {
    "enabled": true,
    "event_trigger": "ON_TOUCH_DOWN",
    "deadzone": {
      "inner_radius": 100,
      "outer_suppression": 100
    },
    "axis_lock": {
      "horizontal_jitter_filter": 100,
      "vertical_tracking_damping": 100,
      "touch_friction_multiplier": 100
    },
    "aim_assist_deceleration": {
      "target_friction_zone": true,
      "slowing_factor": 100,
      "inner_hitbox_scale": 100,
      "outer_slow_ring": 100
    },
    "sampling_rate": {
      "force_stable_hz": true,
      "min_finger_size": 100
    }
  }
}