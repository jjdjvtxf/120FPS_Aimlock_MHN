#import <UIKit/UIKit.h>

// Estructura opcional para mantener los valores en memoria si necesitas consultarlos
struct VortexConfig {
    int touchSampleRateHz = 120;
    bool touchEventCoalescing = true;
    double touchMaxForce = 6.67;
    double touchForceMultiplier = 2.0;
    double touchAltitudeBias = 1.57;
    double touchAzimuthBias = 3.14;
    bool touchEstimatedProps = true;
    double touchGestureDelay = 0.0;
    double touchEdgeInset = 20.0;
    double touchHapticIntensity = 1.0;
    
    double motionGyroInterval = 0.0083;
    double motionAccelInterval = 0.0083;
    double motionDeviceInterval = 0.0083;
    int motionAttitudeRef = 3;
    bool motionMagCalibration = true;
    double motionLowPassAlpha = 1.0;
    bool motionYawDrift = true;
    double motionPitchClamp = 1.57;
    double motionRotationScale = 2.0;
    int motionSensorFusion = 2;
    
    double camTppSens = 10.0;
    double camFppSens = 10.0;
    double camRedDot = 10.0;
    double camHolo = 10.0;
    double camScope2x = 10.0;
    double camScope3x = 10.0;
    double camScope4x = 10.0;
    double camScope6x = 10.0;
    double camScope8x = 10.0;
    double camFreeLook = 10.0;
    
    int inputCurveType = 2;
    double inputBezier1 = 10.0;
    double inputBezier2 = 10.0;
    double inputVelocityScaling = 10.0;
    double inputInertiaDecay = 1.0;
    double inputDeadzoneInner = 0.0;
    double inputDeadzoneOuter = 1.0;
    int inputSmoothingWindow = 1;
    double inputJitterThreshold = 0.0;
    double inputPredictionHorizon = 16.6;
    
    int renderDisplayLinkFps = 120;
    int renderMaxFramePacing = 120;
    int renderPreferredFps = 120;
    int systemThreadPriorityQos = 33;
    bool systemThermalBypass = false;
    int systemGpuQueueDepth = 3;
    bool systemLowPowerOverride = false;
};

static VortexConfig currentConfig;

// Constructor que se ejecuta automáticamente al inyectarse el .dylib en la app
__attribute__((constructor)) static void initVortexDylib() {
    NSLog(@"[Vortex 👾] Configuración JSON cargada e inyectada exitosamente en memoria.");
    
    // Aquí puedes aplicar hooks a clases de UIKit o del motor del juego (Unity/Unreal) 
    // para forzar estos valores en tiempo de ejecución.
}