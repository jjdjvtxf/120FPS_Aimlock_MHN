import json

# Cargar la configuración JSON
with open('touch_config.json') as f:
    config = json.load(f)['touch_config']

def aplicar_filtro_tactil(delta_x, delta_y):
    if not config['enabled']:
        return delta_x, delta_y

    # Aplicar filtro contra el temblor horizontal (Jitter)
    filter_h = config['axis_lock']['horizontal_jitter_filter']
    smooth_x = delta_x * (1.0 - filter_h)

    # Aplicar fricción vertical
    damping_v = config['axis_lock']['vertical_tracking_damping']
    smooth_y = delta_y * (1.0 - damping_v)

    return smooth_x, smooth_y